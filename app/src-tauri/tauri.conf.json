{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shizi",
  "version": "0.1.0",
  "identifier": "com.shizi.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "拾字",
        "width": 582,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "shadow": true,
        "focus": false
      },
      {
        "label": "manager",
        "title": "拾字 · 词库管理",
        "url": "manager.html",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
